# Copy to .env.local (gitignored) for local dev, and set the same keys in the
# Vercel project settings (Environment Variables) for production/preview.

# --- Supabase (Settings > API in your Supabase project) ---
# Server-only — used by /api functions via the service-role key. NEVER prefix
# these with VITE_ or they will be bundled into the public client build.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Client-side — safe to expose, used by the browser Supabase client for member
# login (src/lib/supabaseClient.ts). Must be prefixed with VITE_ so Vite inlines them.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Checkout platform webhook (Hotmart reference implementation) ---
# Hotmart: Ferramentas > Webhook > Token (HOTTOK) in the product's settings.
HOTMART_HOTTOK=

# Public URL of this site, used as the member-invite email's redirect target.
# Optional on Vercel (falls back to the auto-populated VERCEL_URL) — set explicitly
# once you have a custom domain, and always set it for local dev via .env.local.
PUBLIC_SITE_URL=
# Same value, exposed to the browser — src/pages/Login.tsx's magic-link redirect must
# match the webhook's PUBLIC_SITE_URL above exactly, or Supabase's Redirect URL
# allow-list can silently send the user somewhere /membros never gets processed.
VITE_PUBLIC_SITE_URL=

# --- Server-side conversion tracking (optional but recommended) ---
# GA4: Admin > Data Streams > Measurement Protocol API secrets.
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
VITE_GA4_MEASUREMENT_ID=

# Meta: Events Manager > Conversions API > Generate access token.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
VITE_META_PIXEL_ID=
